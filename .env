# Supabase Postgres connection string (Transaction/Pooler URL for runtime)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Supabase direct connection string (used by Prisma migrate commands)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=public"

# Session secret - change this to a long random string in production
SESSION_SECRET="your-super-secret-session-key-change-this-in-production-min-32-chars"
